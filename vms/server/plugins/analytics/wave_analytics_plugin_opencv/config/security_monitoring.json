      "startHour": 18,
      "endHour": 8
    },
    {
      "name": "restricted_zone_2",
      "type": "intrusion",
      "coordinates": [[600, 200], [900, 200], [900, 500], [600, 500]],
      "activeAtNight": false,
      "startHour": 0,
      "endHour": 24
    },
    {
      "name": "loitering_zone",
      "type": "monitoring",
      "coordinates": [[100, 400], [500, 400], [500, 700], [100, 700]],
