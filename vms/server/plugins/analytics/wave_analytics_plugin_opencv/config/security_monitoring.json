      "zone": "restricted_zone_1",
      "priority": "critical",
      "enabled": true
    },
    {
      "name": "Vehicle near building",
      "condition": "(object.type == 'car' || object.type == 'truck' || object.type == 'motorcycle')",
      "zone": "restricted_zone_2",
      "priority": "high",
      "enabled": true
    },
    {
      "name": "Multiple people loitering",
      "zone": "loitering_zone",
      "minCount": 3,
      "priority": "medium",
      "enabled": true
    }
  ]
